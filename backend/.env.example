# ─── LLM providers ───────────────────────────────────────────────
# Leave ALL of these blank to run the coach on the deterministic FakeProvider
# (no network, no keys). Set a key to activate that provider automatically.
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: live web search for the coach's research tool (falls back to curated).
TAVILY_API_KEY=

# Model IDs (per techstack.md model-routing table)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.5-flash

# ─── Persistence (local Postgres; same URL shape as Supabase) ────
# Matches docker-compose.yml (host port 5433 to dodge a local Postgres on 5432).
# For Supabase later, swap in its connection string.
DATABASE_URL=postgresql://coach:coach@localhost:5433/aicoach

# ─── App ─────────────────────────────────────────────────────────
# Path to the competency map (source of truth lives at repo root).
COMPETENCY_MAP_PATH=../competency_map.json
# Weighted coverage of critical+high competencies at which assessment can stop.
COVERAGE_THRESHOLD=0.7
LOG_LEVEL=INFO
